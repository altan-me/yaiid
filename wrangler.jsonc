{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "yaiid",
  "main": "src/index.js",
  // Set this to today's date
  "compatibility_date": "2026-11-14",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 20, "period": 60 }
    }
  ],
  "observability": { "enabled": true }
}
